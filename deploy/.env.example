# =====================================================================
# ASH — the environment of one deployment (task 052). Copy to .env, fill in, keep it OUT of git and readable by the
# deploying account only. One file per environment (Uat, Production). Every value is required unless marked optional.
# The API refuses to start and lists EVERY missing setting when one is missing (StartupValidator).
# =====================================================================

# --- release -----------------------------------------------------------
ASH_REGISTRY=ghcr.io/OWNER                # TODO(akshi-q-registry)
ASH_VERSION=0.0.0                         # the release tag without "v" (release.yml fills it in the bundle)
ASH_ENVIRONMENT=Production                # Uat | Production (the footer shows it outside Production)
ASH_ENVIRONMENT_SLUG=prod                 # compose project name suffix: uat | prod

# --- database (MySQL 8, deploy/mysql/); every connection SslMode=VerifyFull ----------------------------
# one account per connection (least privilege); the passwords from deploy/mysql/production-accounts.sql.template
ASH_DB_MIGRATOR=Server=db.example;Port=3306;User ID=ash_migrator;Password=CHANGE;SslMode=VerifyFull
ASH_DB_APP=Server=db.example;Port=3306;Database=ash_core;User ID=ash_app;Password=CHANGE;SslMode=VerifyFull
ASH_DB_AUDIT=Server=db.example;Port=3306;Database=ash_audit;User ID=ash_audit_writer;Password=CHANGE;SslMode=VerifyFull
ASH_DB_AUDIT_DIGEST=Server=db.example;Port=3306;Database=ash_audit;User ID=ash_audit_digest;Password=CHANGE;SslMode=VerifyFull
ASH_DB_CHAT=Server=db.example;Port=3306;Database=ash_chat;User ID=ash_chat_app;Password=CHANGE;SslMode=VerifyFull
# the read replica (reports); the primary when there is no replica yet
ASH_DB_REPORTING=Server=db-replica.example;Port=3306;Database=ash_core;User ID=ash_reporting;Password=CHANGE;SslMode=VerifyFull

# --- object storage (S3-compatible) -----------------------------------------
ASH_STORAGE_URL=https://s3.example
ASH_STORAGE_PUBLIC_URL=https://s3.example # what the browser uses for the signed download links
ASH_STORAGE_ACCESS_KEY=CHANGE
ASH_STORAGE_SECRET_KEY=CHANGE
ASH_BUCKET_QUARANTINE=ash-uploads-quarantine   # lifecycle: expire after 1 day
ASH_BUCKET_DOCUMENTS=ash-documents             # object lock ON
ASH_BUCKET_CHAT=ash-chat-files                 # versioning ON

# --- e-mail (AKSHI's SMTP relay) ------------------------------------------------
ASH_EMAIL_ENABLED=true
ASH_SMTP_HOST=smtp.example
ASH_SMTP_PORT=587
ASH_SMTP_SECURITY=StartTls                # None | StartTls | SslOnConnect
ASH_SMTP_USER=                            # optional; when set, ASH_SMTP_PASSWORD is required
ASH_SMTP_PASSWORD=
ASH_SMTP_FROM=noreply@ash.example

# --- identity (Azure AD B2C, one tenant per environment) ----------------------
ASH_B2C_AUTHORITY=https://TENANT.b2clogin.com/TENANT.onmicrosoft.com/B2C_1_signin
ASH_B2C_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ASH_B2C_API_AUDIENCE=00000000-0000-0000-0000-000000000000
# the token's "iss" exactly as B2C writes it (the user flow's metadata, "issuer")
ASH_B2C_ISSUER=https://TENANT.b2clogin.com/00000000-0000-0000-0000-000000000000/v2.0/
ASH_B2C_API_SCOPE=https://TENANT.onmicrosoft.com/ash-api/access
# the SAME host as the authority — the CSP allows it (a difference shows "Konfigurimi i hyrjes nuk përputhet me CSP")
ASH_IDP_HOSTS=TENANT.b2clogin.com

# --- web / proxy -------------------------------------------------------------------
ASH_WEB_BIND=127.0.0.1:8080               # where the ingress reaches the web container
ASH_PROXY_NETWORK=172.16.0.0/12           # the network the reverse proxy / ingress connects from (CIDR)
ASH_HSTS=off                              # "off" when the ingress terminates TLS and sends HSTS itself
ASH_MAX_UPLOAD_MB=50

# --- scaling -------------------------------------------------------------------------
ASH_API_INSTANCES=1                       # > 1 requires ASH_REDIS (the SignalR backplane)
ASH_REDIS=                                # optional; e.g. redis:6379,password=…,ssl=false
ASH_REDIS_PASSWORD=                       # only with the "redis" profile
