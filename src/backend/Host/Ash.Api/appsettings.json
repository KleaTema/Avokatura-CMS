{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Providers": [
      {
        "Name": "b2c",
        "Kind": "B2C",
        "Enabled": false,
        "Authority": "",
        "MetadataAddress": "",
        "ClientId": "",
        "Audience": "",
        "ValidIssuers": [],
        "AllowedTenantIds": [],
        "Scopes": [],
        "DisplayName": "Hyr me email dhe fjalëkalim"
      },
      {
        "Name": "entra",
        "Kind": "EntraId",
        "Enabled": false,
        "Authority": "",
        "MetadataAddress": "",
        "ClientId": "",
        "Audience": "",
        "ValidIssuers": [],
        "AllowedTenantIds": [],
        "Scopes": [],
        "DisplayName": "Hyr me llogarinë e institucionit (Microsoft)"
      }
    ]
  },
  "Storage": {
    "ServiceUrl": "",
    "PublicServiceUrl": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "Buckets": {
      "Quarantine": "ash-uploads-quarantine",
      "Documents": "ash-documents",
      "Chat": "ash-chat-files"
    }
  },
  "Database": {
    "QueryTimeLimitSeconds": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimits": {
    "upload": { "PermitLimit": 30, "WindowSeconds": 60 },
    "export": { "PermitLimit": 10, "WindowSeconds": 60 },
    "search": { "PermitLimit": 60, "WindowSeconds": 60 },
    "crossOffice": { "PermitLimit": 20, "WindowSeconds": 60 },
    "notify": { "PermitLimit": 5, "WindowSeconds": 60 },
    "hub": { "PermitLimit": 20, "WindowSeconds": 60 }
  },
  "Reports": {
    "ExportQueryTimeLimitSeconds": 60,
    "MaxExportRows": 200000
  },
  "Jobs": {
    "Enabled": true
  },
  "Scanner": {
    "Mode": "ClamAv",
    "ClamAv": {
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 60
    },
    "Job": {
      "IntervalSeconds": 5,
      "BatchSize": 10,
      "MaxAttempts": 5
    }
  }
}
