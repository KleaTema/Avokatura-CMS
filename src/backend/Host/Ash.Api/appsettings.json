{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "",
    "Audience": ""
  },
  "Storage": {
    "ServiceUrl": "",
    "PublicServiceUrl": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "Buckets": {
      "Quarantine": "ash-uploads-quarantine",
      "Documents": "ash-documents",
      "Chat": "ash-chat-files"
    }
  },
  "Database": {
    "QueryTimeLimitSeconds": 5
  },
  "Jobs": {
    "Enabled": true
  },
  "Scanner": {
    "Mode": "ClamAv",
    "ClamAv": {
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 60
    },
    "Job": {
      "IntervalSeconds": 5,
      "BatchSize": 10,
      "MaxAttempts": 5
    }
  }
}
