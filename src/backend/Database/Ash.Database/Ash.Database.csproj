<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>ash-database-migrator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.sql" />
    <EmbeddedResource Include="LocalScripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-mysql" />
    <!-- direct reference only to lift dbup-mysql's transitive MySqlConnector to the patched version -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

</Project>
